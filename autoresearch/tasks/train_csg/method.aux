\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The \texttt  {train\_csg} differentiable optimization, evaluation, and early-stopping loop.} At each training iteration $i$, commanded tool displacements $\bm  {\delta }^{(i)}$ are passed through speed-limit and $z$-floor subgradient gates into the differentiable CSG carving simulator unrolled within a \texttt  {ti.ad.Tape}. Backpropagated gradients $\partial \mathcal  {L}_{\mathrm  {geom}}/\partial \bm  {\delta }$ are $\ell _2$-norm clipped to update the trajectory parameters via Adam. Periodically (every $K$ iterations), soft refinement branches to execute an exact boolean carve from the canonical tool start $\mathbf  {x}_0$, scoring deployable metrics (Dice, ASD, HD95). Whenever deployable hard Dice surpasses the historical maximum, an early-stopping authority snapshots the exact pre-step trajectory and metric dictionary into memory without end-of-training re-evaluation (circumventing GPU atomic-add reduction nondeterminism).}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:optim_eval_loop}{{1.5}{3}{The Optimization and Evaluation Loop}{figure.1}{}}
\newlabel{eq:loss}{{6}{3}{Loss Function}{equation.1.6}{}}
