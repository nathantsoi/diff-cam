\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The \texttt  {train\_csg} differentiable optimization, evaluation, and early-stopping loop.} At each training iteration $i$, commanded tool displacements $\bm  {\delta }^{(i)}$ are passed through speed-limit and $z$-floor subgradient gates into the differentiable CSG carving simulator unrolled within a \texttt  {ti.ad.Tape}. The smoothness $k^{(i)}$ is annealed (Sec.\nobreakspace  {}\ref  {sec:gap}) and the loss is de-biased by $\Delta $ (Sec.\nobreakspace  {}\ref  {sec:gap}). Backpropagated gradients $\partial \mathcal  {L}_{\mathrm  {geom}}/\partial \bm  {\delta }$ are $\ell _2$-norm clipped to update the trajectory parameters via Adam. Periodically (every $K$ iterations), soft refinement branches to execute an exact boolean carve from the canonical tool start $\mathbf  {x}_0$, scoring deployable metrics (Dice, ASD, HD95). Whenever deployable hard Dice surpasses the historical maximum, an early-stopping authority snapshots the exact pre-step trajectory and metric dictionary into memory.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:optim_eval_loop}{{1}{4}{\textbf {The \texttt {train\_csg} differentiable optimization, evaluation, and early-stopping loop.} At each training iteration $i$, commanded tool displacements $\boldsymbol {\delta }^{(i)}$ are passed through speed-limit and $z$-floor subgradient gates into the differentiable CSG carving simulator unrolled within a \texttt {ti.ad.Tape}. The smoothness $k^{(i)}$ is annealed (Sec.~\ref {sec:gap}) and the loss is de-biased by $\Delta $ (Sec.~\ref {sec:gap}). Backpropagated gradients $\partial \mathcal {L}_{\mathrm {geom}}/\partial \boldsymbol {\delta }$ are $\ell _2$-norm clipped to update the trajectory parameters via Adam. Periodically (every $K$ iterations), soft refinement branches to execute an exact boolean carve from the canonical tool start $\mathbf {x}_0$, scoring deployable metrics (Dice, ASD, HD95). Whenever deployable hard Dice surpasses the historical maximum, an early-stopping authority snapshots the exact pre-step trajectory and metric dictionary into memory}{figure.1}{}}
